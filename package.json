{
  "name": "art-design-pro",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite preview",
    "test:phase2": "tsx scripts/run-phase2-tests.ts",
    "test:phase3": "tsx scripts/run-phase3-tests.ts",
    "test:phase3b": "tsx scripts/run-phase3b-tests.ts",
    "test:phase3c": "tsx scripts/run-phase3c-tests.ts",
    "test:phase4": "tsx scripts/run-phase4-tests.ts",
    "test:phase4b": "tsx scripts/run-phase4b-tests.ts",
    "test:phase5": "tsx scripts/run-phase5-tests.ts",
    "test:phase6": "tsx scripts/run-phase6-tests.ts",
    "test:phase7": "tsx scripts/run-phase7-tests.ts",
    "test:phase8": "tsx scripts/run-phase8-tests.ts",
    "test:phase9": "tsx scripts/run-phase9-tests.ts",
    "test:phase11": "tsx scripts/run-phase11-tests.ts",
    "test:phase11b": "tsx scripts/run-phase11b-tests.ts",
    "test:phase12": "tsx scripts/run-phase12-tests.ts",
    "test:phase13": "tsx scripts/run-phase13-tests.ts",
    "test:phasec1": "tsx scripts/run-phasec1-tests.ts",
    "test:phasec2": "tsx scripts/run-phasec2-tests.ts",
    "test:all": "tsx scripts/run-phase2-tests.ts && tsx scripts/run-phase3-tests.ts && tsx scripts/run-phase3b-tests.ts && tsx scripts/run-phase3c-tests.ts && tsx scripts/run-phase4-tests.ts && tsx scripts/run-phase5-tests.ts && tsx scripts/run-phase6-tests.ts && tsx scripts/run-phase7-tests.ts && tsx scripts/run-phase8-tests.ts && tsx scripts/run-phase9-tests.ts && tsx scripts/run-phase11-tests.ts && tsx scripts/run-phase11b-tests.ts && tsx scripts/run-phase12-tests.ts && tsx scripts/run-phase13-tests.ts && tsx scripts/run-phasec1-tests.ts && tsx scripts/run-phasec2-tests.ts",
    "lint": "eslint",
    "fix": "eslint --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint  \"**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky || true",
    "commit": "git-cz",
    "clean:dev": "tsx scripts/clean-dev.ts"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json,jsonc}": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{html,htm}": [
      "prettier --write"
    ],
    "*.{scss,css,less}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ],
    "*.{yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.0",
    "@supabase/supabase-js": "^2.117.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vue/reactivity": "^3.5.21",
    "@vueuse/core": "^13.9.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "next",
    "axios": "^1.12.2",
    "crypto-js": "^4.2.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "highlight.js": "^11.10.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.3.0",
    "qrcode.vue": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "vue": "^3.5.21",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.5.1",
    "xgplayer": "^3.0.20",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.0.5",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "commitizen": "^4.3.0",
    "cz-git": "^1.11.1",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.27.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.9.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.81.0",
    "stylelint": "^16.20.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^4.6.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.1",
    "terser": "^5.36.0",
    "tsx": "^4.20.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.9.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vue-demi": "^0.14.9",
    "vue-img-cutter": "^3.0.5",
    "vue-tsc": "~2.1.6"
  }
}
